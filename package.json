{
  "name": "@favasconcelos/biome-config",
  "version": "1.0.0-beta.1",
  "description": "Shared Biome configuration presets: base, lib and react",
  "keywords": [
    "biome",
    "biome-config",
    "config",
    "linter",
    "formatter",
    "shared-config"
  ],
  "license": "MIT",
  "author": "Felipe Vasconcelos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/favasconcelos/biome-config.git"
  },
  "homepage": "https://github.com/favasconcelos/biome-config#readme",
  "bugs": {
    "url": "https://github.com/favasconcelos/biome-config/issues"
  },
  "type": "module",
  "exports": {
    "./base": "./presets/base.json",
    "./lib": "./presets/lib.json",
    "./react": "./presets/react.json",
    "./package.json": "./package.json"
  },
  "files": [
    "presets"
  ],
