{
  "linter": {
    "rules": {
      "suspicious": { "noExplicitAny": "error", "noConsole": "warn" },
      "style": { "noDefaultExport": "error", "useNodejsImportProtocol": "error" },
      "performance": { "noReExportAll": "error" },
      "correctness": { "noUnusedImports": "error", "noUnusedVariables": "error" }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.config.*", "**/*.d.ts"],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
    },
    {
      "includes": ["**/*.test.*", "**/*.spec.*", "**/test/**", "**/tests/**", "**/__tests__/**"],
      "linter": {
        "rules": {
          "suspicious": { "noConsole": "off" },
          "style": { "noDefaultExport": "off" }
        }
      }
    }
  ]
}
